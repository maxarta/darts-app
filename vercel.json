{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api", "destination": "/api/gateway?__p=" },
    { "source": "/api/(.*)", "destination": "/api/gateway?__p=$1" },
    {
      "source": "/tv",
      "destination": "/index.html"
    },
    {
      "source": "/tv/:path*",
      "destination": "/index.html"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
