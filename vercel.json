{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/tv",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api", "destination": "/api/gateway?__p=" },
    { "source": "/api/(.*)", "destination": "/api/gateway?__p=$1" },
    {
      "source": "/tv",
      "destination": "/index.html"
    },
    {
      "source": "/tv/:path*",
      "destination": "/index.html"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
