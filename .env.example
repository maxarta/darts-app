# Скопируйте в .env.local (секреты сюда не кладите)

WEBAPP_URL=https://your-app.vercel.app
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Локальный API (Vite проксирует /api → этот порт)
API_PORT=5002

# Опционально: публичная ссылка автора на главной
# VITE_AUTHOR_TELEGRAM=https://t.me/maxartemyev

# Код входа в расширенный клуб (по умолчанию polyana)
# VITE_EXTENDED_ACCESS_CODE=polyana

# Опционально: Supabase CLI
# DB_PASSWORD=

# Опционально: только для `gh` в терминале — не для Vercel и не для git push
# GITHUB_TOKEN=
