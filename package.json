{
  "name": "darts-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx server/dev.ts",
    "dev:5001": "npm run dev",
    "build": "vite build && node scripts/build-api.mjs",
    "start": "tsx server/dev.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "optimize:achievements": "node scripts/optimize-achievement-images.mjs",
    "db:migrate": "echo 'Откройте Supabase Dashboard → SQL Editor и выполните supabase/migrations/001_initial.sql'"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@hono/node-server": "^1.19.1",
    "@supabase/supabase-js": "^2.105.4",
    "@twa-dev/sdk": "^8.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "grammy": "^1.43.0",
    "hono": "^4.9.7",
    "lucide-react": "^1.16.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.9.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.9",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6",
    "workbox-window": "^7.4.1"
  }
}
